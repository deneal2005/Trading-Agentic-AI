# Copy to .env and fill in locally. Never commit .env.
# Environment the system runs in. Order submission additionally requires
# execution.enabled: true in config AND a matching broker environment.
TRADEINTEL_ENV=local

# --- LLM (optional; the system runs without one) ---
# provider: none | ollama | anthropic
TRADEINTEL_LLM_PROVIDER=none
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
ANTHROPIC_API_KEY=

# --- Demo broker (OANDA practice). Live is refused by code. ---
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice
